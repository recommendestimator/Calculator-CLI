          <mxGeometry height="40" width="370" x="10" y="70" as="geometry" />
        </mxCell>
        <mxCell id="sXixKk3Lbpg7duMG6is4-23" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Properties of each &lt;u&gt;Term&lt;/u&gt;:&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;If you call &lt;i&gt;Term.Calculate()&lt;/i&gt;, it should return &lt;b style=&quot;&quot;&gt;a singular value&lt;/b&gt;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;gt; The &quot;result&quot; of that particular Term.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;The&lt;b&gt; sum of all Terms is just the result of the entire expression&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;gt; So subtraction doesn&#39;t really exist. It is, instead, just an additive inverse.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;gt;&amp;gt; &quot;3 - 2&quot; is actually &quot;3 + (-2)&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="500" x="920" y="720" as="geometry" />
        </mxCell>
